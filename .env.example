DB_URL=jdbc:postgresql://localhost:5432/campushub
DB_USER=root
DB_PASSWORD=rootpassword
# Security Secrets (Must be at least 32 bytes for production)
JWT_SECRET=your_secure_random_jwt_secret_min_32_bytes_length
PICKUP_ENCRYPTION_KEY=your_secure_random_pickup_aes_key_32_bytes
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@campushub.com
MAIL_SENDER_NAME=CampusHub
ADMIN_EMAIL=admin@campushub.com
ADMIN_PASSWORD=StrongAdminP@ssw0rd!
# Frontend URL used in email links (no trailing slash)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary Configuration (Upload ảnh)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Render Deployment & Self-Ping (Giữ server Render không bị sleep 15 phút)
PORT=8080
SELF_PING_ENABLED=true
# Đường dẫn công khai trên Render (Render tự động có biến RENDER_EXTERNAL_URL)
# Hoặc tự điền URL Render: https://<your-app-name>.onrender.com/api/v1/ping
SELF_PING_URL=
SELF_PING_INTERVAL_MS=300000

# Cổng thanh toán PayOS (QR Code Pay-in)
# Lấy tại Dashboard: https://payos.vn/
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/orders
PAYOS_CANCEL_URL=http://localhost:5173/orders
# Đặt true để mô phỏng quét mã thành công không cần tài khoản thật (chế độ local/dev), đặt false trên production
PAYOS_SIMULATION_ENABLED=true

# OCR & AI Identity Service (Dịch vụ Python nhận diện CCCD)
OCR_SERVICE_URL=http://localhost:8081
OCR_CONNECT_TIMEOUT_MS=2000
OCR_READ_TIMEOUT_MS=8000

# Quét quá hạn đơn hàng (ms)
ORDER_EXPIRATION_CHECK_INTERVAL_MS=60000

